{
  "$defs": {
    "WorkerManifestExecution": {
      "properties": {
        "adapter": {
          "enum": [
            "cli",
            "http",
            "managed_agent"
          ],
          "title": "Adapter",
          "type": "string"
        },
        "entrypoint": {
          "items": {
            "type": "string"
          },
          "title": "Entrypoint",
          "type": "array"
        }
      },
      "required": [
        "adapter"
      ],
      "title": "WorkerManifestExecution",
      "type": "object"
    },
    "WorkerRequirements": {
      "properties": {
        "target": {
          "default": false,
          "title": "Target",
          "type": "boolean"
        },
        "workspace": {
          "default": true,
          "title": "Workspace",
          "type": "boolean"
        },
        "device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device"
        }
      },
      "title": "WorkerRequirements",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "worker_id": {
      "title": "Worker Id",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "supports_targets": {
      "items": {
        "type": "string"
      },
      "title": "Supports Targets",
      "type": "array"
    },
    "requires": {
      "$ref": "#/$defs/WorkerRequirements"
    },
    "task_schema": {
      "default": "1.x",
      "title": "Task Schema",
      "type": "string"
    },
    "result_schema": {
      "default": "1.0",
      "title": "Result Schema",
      "type": "string"
    },
    "execution": {
      "$ref": "#/$defs/WorkerManifestExecution"
    }
  },
  "required": [
    "worker_id",
    "version",
    "capabilities",
    "supports_targets",
    "execution"
  ],
  "title": "WorkerManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-qc.local/schemas/worker-manifest-1.1.json"
}
