{
  "$defs": {
    "ErrorDetail": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "category": {
          "enum": [
            "authentication",
            "authorization",
            "webhook",
            "repository",
            "configuration",
            "planning",
            "execution",
            "target",
            "infrastructure",
            "internal"
          ],
          "title": "Category",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "code",
        "message",
        "category"
      ],
      "title": "ErrorDetail",
      "type": "object"
    },
    "Finding": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "start_line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Line"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "triage": {
          "anyOf": [
            {
              "$ref": "#/$defs/FindingTriage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "severity",
        "category",
        "title",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingTriage": {
      "properties": {
        "classification": {
          "enum": [
            "real_bug",
            "flaky",
            "environment",
            "unknown"
          ],
          "title": "Classification",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_used": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Used",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "duplicate_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Of"
        },
        "proposed_action": {
          "enum": [
            "report",
            "suppress",
            "escalate_human"
          ],
          "title": "Proposed Action",
          "type": "string"
        }
      },
      "required": [
        "classification",
        "confidence",
        "rationale",
        "proposed_action"
      ],
      "title": "FindingTriage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "capability": {
      "default": "unit.run",
      "title": "Capability",
      "type": "string"
    },
    "worker_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Worker Id"
    },
    "implementation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Implementation"
    },
    "worker_kind": {
      "anyOf": [
        {
          "enum": [
            "external_agent",
            "tool",
            "managed_agent"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Worker Kind"
    },
    "execution_status": {
      "enum": [
        "completed",
        "failed",
        "cancelled",
        "timed_out"
      ],
      "title": "Execution Status",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "warning",
        "skipped",
        "unknown"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Code"
    },
    "output": {
      "default": "",
      "title": "Output",
      "type": "string"
    },
    "summary": {
      "additionalProperties": true,
      "title": "Summary",
      "type": "object"
    },
    "metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Metrics",
      "type": "object"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorDetail"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "task_id",
    "run_id",
    "execution_status",
    "verdict"
  ],
  "title": "WorkerResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-qc.local/schemas/worker-result-1.1.json"
}
