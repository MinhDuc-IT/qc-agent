# Secret belongs to this worker, not to the QC orchestrator task payload.
HERCULES_LLM_API_KEY=replace-me
HERCULES_LLM_MODEL=gpt-4o-mini
HERCULES_LLM_BASE_URL=https://api.openai.com/v1
HERCULES_AGENT_TOKEN=replace-with-a-long-random-token
HERCULES_MAX_SCENARIOS=3
HERCULES_MAX_STEPS=15
HERCULES_MAX_RUNTIME_SECONDS=900
HERCULES_ALLOWED_SOURCE_ROOT=I:\path\to\Agent-QC\.agent-qc-workspaces
HERCULES_WORK_ROOT=I:\path\to\Agent-QC\.agent-qc-hercules
