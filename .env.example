GITHUB_WEBHOOK_SECRET=change-me
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Must match the public URL configured in GitHub App callback/setup settings.
AGENT_QC_PUBLIC_URL=http://127.0.0.1:8000
AGENT_QC_TDA_ENABLED=true
AGENT_QC_TDA_WORKSPACE_ENABLED=true
AGENT_QC_TDA_MAX_CASES=100
AGENT_QC_TDA_MAX_ROUNDS=3
AGENT_QC_TDA_MAX_OUTPUT_TOKENS=16000
AGENT_QC_TDA_DIR=.data/test-design
# Empty uses OPENAI_MODEL. Configure these once for all installations.
AGENT_QC_TDA_MODEL=
AGENT_QC_TDA_REASONING_EFFORT=low
AGENT_QC_TDA_MAX_CALLS=24
AGENT_QC_TDA_TIMEOUT_SECONDS=180
AGENT_QC_TDA_MAX_INPUT_CHARS=60000
AGENT_QC_TDA_MAX_SOURCE_BYTES=160000
AGENT_QC_DATA_DIR=.data
# Keep runtime checkouts outside qc-agent so uvicorn --reload does not restart.
AGENT_QC_WORKSPACE_DIR=../.agent-qc-workspaces
AGENT_QC_DRY_RUN=true
AGENT_QC_PUBLISH_PR_REVIEW=true
AGENT_QC_AGENT_ENABLED=true
OPENAI_API_KEY=
# TDA uses a separate key; it never falls back to the QC key above.
TDA_OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AGENT_QC_EXTERNAL_AGENTS_FILE=external-agents.yaml
AGENT_QC_EXECUTION_BACKEND=local
# Used only when AGENT_QC_EXECUTION_BACKEND=docker. Every image must use an immutable tag/digest.
AGENT_QC_DOCKER_IMAGES_FILE=docker-images.yaml
# Required for POST /api/v1/runs. Comma-separated GitHub logins are authorized.
AGENT_QC_MANUAL_API_TOKEN=
AGENT_QC_MANUAL_ALLOWLIST=
AGENT_QC_LOCAL_TARGET_ENABLED=true
AGENT_QC_TDA_RUNNERS=http,unit,browser,k6,ai
# Optional reference execution. Test design approval does not require application tests to pass.
AGENT_QC_TDA_REFERENCE_EXECUTION=false
AGENT_QC_TEST_ISOLATION=docker
AGENT_QC_K6_BINARY=.tools/k6/k6.exe
AGENT_QC_BROWSER_CHANNEL=chrome
TRIAGE_MIN_CONF=0.9
TRIAGE_MAX_CONFIRMATIONS=1
PLANNER_MAX_DIFF_TOKENS=20000
AGENT_QC_ORG_POLICY_FILE=org-policy.yaml
AGENT_QC_ARTIFACT_RETENTION_DAYS=30
AGENT_QC_SCHEDULE_ENABLED=false
AGENT_QC_DEPLOYMENT_TRIGGER_ENABLED=false
AGENT_QC_ARTIFACT_DIR=.data/artifacts
AGENT_QC_WORKER_CONCURRENCY=4

# External worker transport tokens. Use different random values in production.
FUNCTIONAL_AGENT_TOKEN=
INTEGRATION_AGENT_TOKEN=
STRIX_AGENT_TOKEN=
PERFORMANCE_AGENT_TOKEN=

# These keys belong only in each worker's process/environment, not in the
# Agent-QC orchestrator environment:
HERCULES_LLM_API_KEY=
HERCULES_LLM_MODEL=gpt-5.4-mini
HERCULES_MAX_SCENARIOS=1
HERCULES_MAX_STEPS=8
HERCULES_MAX_RUNTIME_SECONDS=300
STRIX_LLM_API_KEY=
STRIX_LLM_MODEL=openai/gpt-5.4-mini
STRIX_MAX_BUDGET_USD=1

# Maximum read/search decisions per module in flow investigation
AGENT_QC_TDA_MAX_INQUIRY_TURNS=6
AGENT_QC_GENERATED_PYTEST_ENABLED=true
